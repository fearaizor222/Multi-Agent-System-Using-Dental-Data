# =====================================================================
# CẤU HÌNH HỆ THỐNG DENTAL MULTI-AGENT VỚI GOOGLE GEMINI
# =====================================================================

# LLM Provider selection: "google", "ollama", hoặc "mock"
LLM_PROVIDER=google

# Model Gemini thế hệ mới
GOOGLE_MODEL_NAME=gemini-2.5-flash
OLLAMA_MODEL_NAME=llama3.1:8b

# Google AI Studio API Key (Lấy tại https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model Configuration (Sử dụng Google Gemini Embeddings)
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
HF_EMBEDDING_MODEL=BAAI/bge-m3

# Hybrid RAG Settings
RAG_TOP_K=4
RRF_K=60
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
CHROMA_PERSIST_DIRECTORY=./data/vectorstore

# System settings
LOG_LEVEL=INFO
DEBUG=True
