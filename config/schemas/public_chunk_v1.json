{
  "$defs": {
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "pdf_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Page"
        },
        "printed_page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Printed Page"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "title": "Locator",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "public-chunk-v1",
      "default": "public-chunk-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "chunk_id": {
      "title": "Chunk Id",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "document_revision": {
      "title": "Document Revision",
      "type": "string"
    },
    "section_id": {
      "title": "Section Id",
      "type": "string"
    },
    "heading_path": {
      "items": {
        "type": "string"
      },
      "title": "Heading Path",
      "type": "array"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "content": {
      "title": "Content",
      "type": "string"
    },
    "token_count": {
      "title": "Token Count",
      "type": "integer"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/TextSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "locators": {
      "items": {
        "$ref": "#/$defs/Locator"
      },
      "title": "Locators",
      "type": "array"
    },
    "chunking": {
      "additionalProperties": true,
      "title": "Chunking",
      "type": "object"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    }
  },
  "required": [
    "chunk_id",
    "document_id",
    "document_revision",
    "section_id",
    "heading_path",
    "source",
    "source_url",
    "language",
    "content",
    "token_count",
    "spans",
    "locators",
    "chunking"
  ],
  "title": "PublicChunk",
  "type": "object"
}