{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "paragraph",
            "list",
            "table",
            "figure_caption",
            "note"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "locators": {
          "items": {
            "$ref": "#/$defs/Locator"
          },
          "minItems": 1,
          "title": "Locators",
          "type": "array"
        },
        "list_items": {
          "items": {
            "type": "string"
          },
          "title": "List Items",
          "type": "array"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "order",
        "kind",
        "text",
        "locators"
      ],
      "title": "Block",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "pdf_page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf Page"
        },
        "printed_page": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Printed Page"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "title": "Locator",
      "type": "object"
    },
    "Processing": {
      "additionalProperties": false,
      "properties": {
        "parser": {
          "title": "Parser",
          "type": "string"
        },
        "parser_version": {
          "default": "1.0.1",
          "title": "Parser Version",
          "type": "string"
        },
        "ingested_at": {
          "title": "Ingested At",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        }
      },
      "required": [
        "parser",
        "method"
      ],
      "title": "Processing",
      "type": "object"
    },
    "RawSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "acquisition_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "title": "RawSource",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "parent_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Section Id"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "order",
        "title",
        "heading_path",
        "locator"
      ],
      "title": "Section",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "rowspan": {
          "default": 1,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "is_header": {
          "default": false,
          "title": "Is Header",
          "type": "boolean"
        }
      },
      "required": [
        "row",
        "column",
        "text"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TableData": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "footnotes": {
          "items": {
            "type": "string"
          },
          "title": "Footnotes",
          "type": "array"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "original_markup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Markup"
        },
        "header_inferred": {
          "default": false,
          "title": "Header Inferred",
          "type": "boolean"
        }
      },
      "required": [
        "cells"
      ],
      "title": "TableData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "public-document-v1",
      "default": "public-document-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Document Id",
      "type": "string"
    },
    "revision_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "source": {
      "enum": [
        "byt",
        "msd",
        "pmc"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_type": {
      "const": "public",
      "default": "public",
      "title": "Source Type",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "content_type": {
      "default": "full_text",
      "enum": [
        "full_text",
        "abstract"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "content_scope": {
      "default": "full_document",
      "enum": [
        "full_document",
        "page_subset"
      ],
      "title": "Content Scope",
      "type": "string"
    },
    "publication_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Date"
    },
    "updated_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated Date"
    },
    "source_metadata": {
      "additionalProperties": true,
      "title": "Source Metadata",
      "type": "object"
    },
    "raw": {
      "$ref": "#/$defs/RawSource"
    },
    "processing": {
      "$ref": "#/$defs/Processing"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "document_id",
    "revision_id",
    "title",
    "source",
    "language",
    "source_url",
    "raw",
    "processing",
    "sections"
  ],
  "title": "PublicDocument",
  "type": "object"
}